# Copia a .env y ajusta. NUNCA subas .env a Git.
# Todas las variables llevan el prefijo BOTTRADE_.

# development | test | production
BOTTRADE_ENVIRONMENT=development

# BACKTEST | PAPER | TESTNET  (no existe modo de dinero real)
BOTTRADE_TRADING_MODE=PAPER

# Base de datos (en producción: contraseña aleatoria de 16+ caracteres)
POSTGRES_PASSWORD=cambia-esto-por-una-clave-larga
BOTTRADE_DATABASE_URL=postgresql+asyncpg://bottrade:cambia-esto-por-una-clave-larga@db:5432/bottrade

# Mercado
BOTTRADE_SYMBOLS=BTCUSDT,ETHUSDT
BOTTRADE_INTERVALS=1m,5m

# Simulación (capital de referencia en USDT, ver docs/decisions.md ADR-002)
BOTTRADE_REFERENCE_CAPITAL=500
BOTTRADE_TAKER_FEE_RATE=0.001
BOTTRADE_SLIPPAGE_BPS=2
BOTTRADE_LATENCY_MS=500

# Solo para BOTTRADE_TRADING_MODE=TESTNET. Claves de https://testnet.binance.vision
# (NO son claves de tu cuenta real de Binance). Ver docs/security.md.
BOTTRADE_TESTNET_API_KEY=
BOTTRADE_TESTNET_API_SECRET=

# API / seguridad
BOTTRADE_CORS_ORIGINS=http://localhost:5173
BOTTRADE_COOKIE_SECURE=false
BOTTRADE_SESSION_TTL_MINUTES=720

BOTTRADE_LOG_LEVEL=INFO
BOTTRADE_LOG_JSON=true
